# Self-contained image for migration / export.
#
# Unlike the standard Dockerfile (which expects HTML pages and nginx.conf to be
# bind-mounted from the host), this variant bakes *everything* into the image so
# that `docker save` produces a portable artifact.  On a fresh server you can
# `docker load` and run with just one volume mount for the persistent SQLite
# database — no extra files needed on the host.
#
# Build:
#   docker build -f Dockerfile.migrate -t huawei-reports-web:latest .
#
# Export:
#   docker save huawei-reports-web:latest | gzip > huawei-reports-web.tar.gz
#
# Import on target:
#   docker load < huawei-reports-web.tar.gz
#

FROM nginx:alpine

RUN apk add --no-cache \
      python3 \
      openssh-client \
      sshpass \
      sqlite \
      tini \
      tzdata \
 && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
 && echo "Asia/Shanghai" > /etc/timezone

WORKDIR /opt/update
COPY scripts/collect_slurm.py /opt/update/collect_slurm.py
COPY scripts/update-slurm.sh  /opt/update/update-slurm.sh
COPY scripts/apikey_server.py /opt/update/apikey_server.py
COPY scripts/auth_server.py   /opt/update/auth_server.py
COPY scripts/entrypoint.sh    /entrypoint.sh
COPY crontab                  /etc/crontabs/root

# DB tooling
COPY db/schema.sql            /opt/dbtools/schema.sql
COPY db/init_db.py            /opt/dbtools/init_db.py
COPY db/aggregate_hpc.py      /opt/dbtools/aggregate_hpc.py
COPY db/backfill_hpc.sh       /opt/dbtools/backfill_hpc.sh
COPY db/admin_bootstrap.py    /opt/dbtools/admin_bootstrap.py
COPY db/migrate_v3.py         /opt/dbtools/migrate_v3.py
COPY db/migrate_v4.py         /opt/dbtools/migrate_v4.py

# ── Self-contained additions (not in standard Dockerfile) ──────────
# Bake HTML pages and nginx.conf into the image so no host bind-mount is
# needed for the web content.  On first boot, the entrypoint copies any
# missing files from /opt/html into the nginx root, preserving any data
# JSON or updated HTML that a previous deployment may have written.

COPY index.html     /opt/html/index.html
COPY apply.html     /opt/html/apply.html
COPY detail.html    /opt/html/detail.html
COPY login.html     /opt/html/login.html
COPY register.html  /opt/html/register.html
COPY profile.html   /opt/html/profile.html
COPY admin.html     /opt/html/admin.html
COPY nginx.conf     /opt/nginx/nginx.conf

RUN chmod +x /opt/update/update-slurm.sh /entrypoint.sh \
            /opt/dbtools/init_db.py /opt/dbtools/aggregate_hpc.py /opt/dbtools/backfill_hpc.sh /opt/dbtools/admin_bootstrap.py /opt/dbtools/migrate_v3.py /opt/dbtools/migrate_v4.py \
 && mkdir -p /var/log/update /opt/db-data /usr/share/nginx/html/data

ENV HPC_HOST=172.16.12.2 \
    HPC_USER=lz \
    DAYS=30 \
    OUT_DIR=/usr/share/nginx/html/data \
    DB_PATH=/opt/db-data/usage.sqlite

ENTRYPOINT ["/sbin/tini","--","/entrypoint.sh"]
