# HPC head node auth for user lz@172.16.12.2.
# Preferred: mount a read-only SSH key into the container.
HPC_SSH_KEY=/opt/ssh/id_ed25519
HPC_SSH_KEY_SRC=/home/liangzhu/huawei-ssh/hpc_lz_ed25519

# Fallback only: personal SSH password for lz@172.16.12.2.
# Leave empty when HPC_SSH_KEY is configured.
HPC_PASSWORD=

# Base64-encoded admin credentials for Huawei AI Platform (10.26.15.52)
# Used by the nightly cron job (update-llm.sh) to collect LLM API token usage.
# Format: echo -n 'username:password' | base64
LLM_API_AUTH=changeme
